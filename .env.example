# --- Admin sign-in (Vercel project > Settings > Environment Variables) ---

# Database for admin accounts, sessions and codes.
# Vercel Marketplace > Upstash Redis injects these automatically
# (KV_REST_API_URL / KV_REST_API_TOKEN are also accepted).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Mail for the verification codes. Use ONE of the two options.
#
# Option A - Gmail (no domain needed). Turn on 2-step verification in the Google
# account, then create an "App password" and paste it here (16 characters).
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
#
# Option B - Resend (https://resend.com). MAIL_FROM must use a domain verified in Resend,
# e.g. "MÖB <no-reply@your-domain.com>". Ignored when the Gmail variables are set.
RESEND_API_KEY=""
MAIL_FROM=""

# Email of the FIRST administrator. It only works while no administrator exists:
# open /admin > "First time / forgot password" with this email to set a password.
ADMIN_BOOTSTRAP_EMAIL=""
